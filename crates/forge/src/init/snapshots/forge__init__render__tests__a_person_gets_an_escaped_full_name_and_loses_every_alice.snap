---
source: forge/src/init/render.rs
expression: "render_person(PERSON, &laptop())"
---
# One person, one folder. A host gives them an account with `users.bob`
# (modules/hosts/example), and `nix run .#init` writes your own person from this file.
{
  users.bob = {
    fullName = "Bob \"the\" Builder \${x}";

    email = "bob@example.net";

    # Public SSH keys allowed to log in as bob.
    sshKeys = [ ];

    apps = [
      "zsh" # zsh with suggestions
      "git" # git, the person's name and email are the author
    ];

    # Any other file of modules/users/bob may set part of it.
    # module = { pkgs, ... }: { home.packages = [ pkgs.gimp ]; };
  };
}
